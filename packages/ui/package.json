{
  "name": "@glot/ui",
  "version": "0.0.0",
  "description": "Glot's look: light and dark tokens, a Tailwind theme, and components built on ui-sdk.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./theme.css": "./src/styles/theme.css",
    "./components/*": "./src/components/*",
    "./constants": "./src/constants/ui.constants.ts",
    "./types": "./src/types/ui.types.ts"
  },
  "scripts": {
    "typecheck": "tsrs -p tsconfig.typecheck.json --noEmit --runExternalCode"
  },
  "dependencies": {
    "@glot/checks": "workspace:*",
    "@glot/contract": "workspace:*",
    "@glot/database": "workspace:*",
    "@glot/utils": "workspace:*",
    "@lucide/vue": "catalog:",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/vue": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  }
}
